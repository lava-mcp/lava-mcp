# Copy to .env and edit for `docker compose up`.
#
# The server holds no per-user token: each connecting client sends its own via the
# X-Lava-Token header. Pin the server to one LAVA instance with LAVA_URL below;
# leave it unset to be multi-tenant (clients then also send X-Lava-Url).

# LAVA instance this MCP server fronts. Set it so clients only send X-Lava-Token.
# Leave commented/empty for a multi-tenant server (clients send X-Lava-Url too).
LAVA_URL=https://lava.example.com

# Where the deployed LAVA's source lives. The server keeps a local git mirror of it,
# checked out at the deployed ref, and read_lava_docs serves docs (Markdown under
# doc/content/) and source from that mirror — so agents read exactly the running code,
# not the Anubis-gated rendered docs site. Requires the `git` binary (in the image).
# LAVA_SOURCE_REF is OPTIONAL — leave it unset to track the LAVA API version (a release
# tag upstream, or the deployed commit for a git-describe build); set it to pin a ref.
LAVA_SOURCE_REPO=https://gitlab.com/lava/lava.git
#LAVA_SOURCE_REF=2026.07
# Optional: local mirror dir (default: a temp subdir) and how often (seconds) the
# background poller re-reads the version and updates the checkout.
#LAVA_SOURCE_DIR=/var/lib/lava-mcp/source
#LAVA_SOURCE_POLL_INTERVAL=300

# Public domain for the MCP HTTPS endpoint (Caddy gets a cert for this).
# Agents connect to https://$LAVA_MCP_DOMAIN/mcp
LAVA_MCP_DOMAIN=lava-mcp.example.com

# Host/IP that lab worker containers can reach to dial the SSH board-session
# gateway (published on TCP :2222). Often the same machine's public/lab IP.
LAVA_MCP_GATEWAY_HOST=lava-mcp.example.com

# Optional access control (all default to open). General LAVA-proxy tools are never
# gated — they equal using one's own LAVA token.
#   GATEWAY_ALLOW_IPS  — source IPs/CIDRs allowed to connect to the SSH gateway (2222)
#   HTTP_ALLOW_USERS   — LAVA users (via whoami) allowed the interactive 'use' tools
#                        (open/run/close/list session, open console, support check)
#   SSH_ALLOW_USERS    — users allowed the 'attach' tools (attach_shell, attach_console)
# LAVA_MCP_GATEWAY_ALLOW_IPS=10.0.0.0/8,192.168.1.5
# LAVA_MCP_HTTP_ALLOW_USERS=alice,bob
# LAVA_MCP_SSH_ALLOW_USERS=alice

# Device tag a device must carry to host remote-access sessions. Defaults to
# 'allow-remote-access'; set empty to disable the per-device gate.
# LAVA_MCP_REMOTE_ACCESS_TAG=allow-remote-access

# Interactive board-session assets (where lab workers pull the container image
# and fetch the test definition). Defaults point at the lava-mcp GHCR/GitHub repo;
# override only if you host them elsewhere.
# Interactive/ser2net job assets default to the RUNNING SERVER'S VERSION: a versioned
# container (e.g. image :0.9) automatically uses the interactive image, ser2net-proxy
# image and git-fetched test definitions at that same version — you don't repeat it
# here. Override any piece only if you host assets elsewhere or want to unpin.
# LAVA_MCP_INTERACTIVE_IMAGE=ghcr.io/lava-mcp/lava-mcp/interactive:0.9
LAVA_MCP_INTERACTIVE_REPO=https://github.com/lava-mcp/lava-mcp.git
LAVA_MCP_INTERACTIVE_PATH=interactive/ssh-gateway.yaml
# Git revision the fetched definitions/compose are pinned to (defaults to the server
# version; set empty to leave unpinned at the repo default branch).
# LAVA_MCP_INTERACTIVE_REF=0.9

# Text-only bug-report inbox (on by default) — agents file short reports about
# lava-mcp/LAVA issues for you to review (list_bug_reports), reply to
# (respond_bug_report), resolve (archived) or purge; the filer reads replies with
# my_bug_reports. Strictly size-bounded so it never eats disk. Set ENABLED=0 to turn off.
# LAVA_MCP_BUG_REPORTS_ENABLED=1
# LAVA_MCP_BUG_REPORT_DIR=/var/lib/lava-mcp/bug-reports
# LAVA_MCP_BUG_REPORT_MAX_BYTES=8192
# LAVA_MCP_BUG_REPORT_TOTAL_MAX_BYTES=4194304
# LAVA_MCP_BUG_REPORT_MAX_COUNT=1000
# Reviewing the inbox (list/respond/resolve/purge) requires a LAVA ADMIN (superuser)
# account, detected via the LAVA REST API. This list narrows further if set — a reviewer
# must then be a LAVA admin AND named here; empty = any LAVA admin. Filing and reading
# your own reports (my_bug_reports) are always open.
# LAVA_MCP_BUG_ADMIN_USERS=alice,bob
