#!/bin/sh
# Open a reverse-SSH tunnel from this device-attached container to the lava-mcp
# gateway. Run by the ssh-gateway.yaml LAVA test definition; the GATEWAY_* /
# SESSION_* values come from the job's test parameters (exported as env vars).
set -eu

: "${GATEWAY_HOST:?missing GATEWAY_HOST}"
: "${GATEWAY_WS_URL:?missing GATEWAY_WS_URL}"
: "${SESSION_ID:?missing SESSION_ID}"
: "${REVERSE_PORT:?missing REVERSE_PORT}"
: "${SESSION_PRIVATE_KEY:?missing SESSION_PRIVATE_KEY}"
: "${SESSION_PUBLIC_KEY:?missing SESSION_PUBLIC_KEY}"

# The SSH stream tunnels over WebSocket/TLS (443, via Caddy) using websocat as an
# ssh ProxyCommand. Held in the positional params ($@, which this script otherwise
# ignores) so the ProxyCommand value — which contains a space — survives as a
# single ssh argument.
set -- -o "ProxyCommand=websocat -b ${GATEWAY_WS_URL}"
echo "lava-mcp: transport = websocket (${GATEWAY_WS_URL})"

mkdir -p /root/.ssh
chmod 700 /root/.ssh
# The gateway connects back into this container using the same session key.
printf '%s\n' "$SESSION_PUBLIC_KEY" >> /root/.ssh/authorized_keys
printf '%s\n' "$SESSION_PRIVATE_KEY" > /root/.ssh/session_key
chmod 600 /root/.ssh/authorized_keys /root/.ssh/session_key

# Expose LAVA's injected environment to gateway ssh sessions. sshd builds a clean env
# per session, so without this the vars LAVA wrote to /lava-<id>/environment (device
# info, board_id/ANDROID_SERIAL, HTTP_CACHE, connection/power commands, ...) — sourced
# into our shell — would be invisible to run_in_session / attach_shell. Re-emit every
# variable that file defines as NAME=value into ~/.ssh/environment (loaded when sshd
# runs with PermitUserEnvironment=yes); values come from our already-sourced env so
# the shell has handled the quoting. NOTE: the LAVA_*_COMMAND values themselves target
# dispatcher-host tools and can't be run directly here — to actually power-cycle etc.,
# a session uses lava-device-command / lava-power-* (see the supervisor below), which
# ask the dispatcher to run the device command on the worker.
for envfile in /lava-*/environment; do
  [ -f "$envfile" ] || continue
  for n in $(sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$envfile"); do
    eval "v=\${$n-}"
    # ~/.ssh/environment is one NAME=value per line; skip any multi-line value
    [ "$v" = "$(printf '%s' "$v" | tr -d '\n')" ] || continue
    printf '%s=%s\n' "$n" "$v"
  done
done > /root/.ssh/environment
chmod 600 /root/.ssh/environment 2>/dev/null || true

# Start this container's sshd (key auth for root is permitted by default).
ssh-keygen -A >/dev/null
mkdir -p /run/sshd
/usr/sbin/sshd -o PermitUserEnvironment=yes

echo "lava-mcp: dialing gateway as ${SESSION_ID}" \
     "(reverse ${REVERSE_PORT} -> localhost:22)"

# Hand off to the session supervisor as the test-shell foreground (exec, so it keeps
# our stdin/stdout — the dispatcher-watched pty). It manages the autossh reverse
# tunnel (the argv after --, with the same bounded retry as before) AND serves a relay
# so agent ssh sessions can issue LAVA device commands (power_on/off, hard_reset, ...)
# and signals, which only work from this foreground pty. It exits with the tunnel's
# status, so the LAVA test action still ends when the session does. autossh keeps
# reconnecting (AUTOSSH_GATETIME=0) within each attempt.
exec python3 /usr/local/bin/lava-session-supervisor \
    --attempts "${GATEWAY_CONNECT_ATTEMPTS:-10}" --retry-delay 5 -- \
    autossh -M 0 -N \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o ServerAliveInterval=30 \
        -o ServerAliveCountMax=3 \
        -o ConnectTimeout=15 \
        -o ExitOnForwardFailure=yes \
        -i /root/.ssh/session_key \
        -R "127.0.0.1:${REVERSE_PORT}:localhost:22" \
        "$@" \
        "${SESSION_ID}@${GATEWAY_HOST}"
